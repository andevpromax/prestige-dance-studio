# ── Shopify Storefront API ────────────────────────────────
# Your Shopify store's myshopify domain (no protocol, no trailing slash).
# Example: prestige-dance.myshopify.com
# (You can also use a custom domain if it's mapped, but myshopify.com is the
# safest default.)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token (PUBLIC-safe, but we still keep it server-only).
# Where to get it:
#   1. Shopify Admin → Settings → Apps and sales channels → Develop apps
#   2. Create an app → Configure Storefront API scopes
#      (enable at minimum: unauthenticated_read_product_listings,
#       unauthenticated_read_product_inventory, unauthenticated_write_checkouts,
#       unauthenticated_read_checkouts)
#   3. Install the app → API credentials → copy the Storefront API access token.
# NOTE: Never use the Admin API access token here.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Storefront API version (YYYY-MM). Check Shopify's release notes for the
# latest stable version: https://shopify.dev/docs/api/release-notes
SHOPIFY_API_VERSION=2025-01

# ── Trial Lesson Notifications ────────────────────────────────

# Resend API key for sending email notifications
# Get it from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address to receive trial lesson notifications
TRIAL_LESSON_TO_EMAIL=studio@example.com

# Email address to send trial lesson notifications from
# Must be verified in Resend (e.g., onboarding@resend.dev for testing, or your domain)
TRIAL_LESSON_FROM_EMAIL=notifications@yourdomain.com

# Telegram Bot Token
# How to get:
#   1. Open Telegram and search for @BotFather
#   2. Send /newbot and follow instructions
#   3. Copy the bot token
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram Chat ID where to send notifications
# How to get:
#   1. Add your bot to a chat/channel or message it directly
#   2. Send a message to the bot
#   3. Visit: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
#   4. Find "chat":{"id": in the response - that's your chat_id
# For personal chat: usually a positive number
# For groups/channels: usually a negative number
TELEGRAM_CHAT_ID=123456789
